-- Heartbeat Live Update
RunService.Heartbeat:Connect(function()
    statusLbl.Text = (running and "⚡ กำลังทำงาน: " or "⏸ สถานะ: ") .. currentStep

    local qc = getQuestContainer()
    local pLbl = qc and qc:FindFirstChild("ProgressLabel", true)
    local designated = getDesignatedWalls()
    if pLbl and qc.Visible and pLbl.Text ~= "" then
        questProgressLbl.Text = string.format("เควส: %s (คงเหลือ %d จุด)", pLbl.Text, #designated)
    else
        questProgressLbl.Text = string.format("จุดที่กำหนด: %d จุด", #designated)
    end

    for i, lbl in ipairs(logLabels) do
        lbl.Text = logs[i] or ""
    end
    logScroll.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y)
    scrollContent.CanvasSize = UDim2.new(0, 0, 0, cLayout.AbsoluteContentSize.Y + 20)
end)

