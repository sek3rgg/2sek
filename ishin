local function addLog(msg)
    local t = os.date("%H:%M:%S")
    table.insert(logs, 1, string.format("[%s] %s", t, msg))
    if #logs > 40 then table.remove(logs) end
end

local function unsitPlayer()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum and hum.Sit then
        hum.Sit = false
        hum.Jump = true
        task.wait(0.05)
    end
end

-- Noclip helper เพื่อให้ตัวละครมุดใต้พื้นได้โดยไม่เด้งขึ้นมา
local noclipConn = nil
local function setNoclip(enabled)
    if enabled then
        if not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                local char = player.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end
end

local function equipSprayCan()
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if char:FindFirstChild("Spray Can") then return true end
    local bp = player:FindFirstChild("Backpack")
    local tool = bp and bp:FindFirstChild("Spray Can")
    if tool and hum then
        hum:EquipTool(tool)
        task.wait(0.1)
        return true
    end
    return false
end

-- หาผนังที่ NPC กำหนด (Indicator.Enabled == true)
local function getDesignatedWalls()
    local folder = getGraffitiFolder()
    if not folder then return {} end
    local list = {}
    for _, wall in ipairs(folder:GetChildren()) do
        local ind = wall:FindFirstChild("GraffitiIndicator")
        if ind and ind.Enabled then
            table.insert(list, wall)
        end
    end
    return list
end

-- Fast Dialogue กับ NPC Thug
local function talkToThugFast()
    currentStep = "กำลังไปหา NPC Thug..."
    addLog("วาร์ปไปคุยกับ Thug")
    unsitPlayer()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local thug = getThug()
    if not root or not thug or not thug:FindFirstChild("HumanoidRootPart") then
        addLog("❌ ไม่พบ NPC Thug")
        return false
    end

    local thugHRP = thug.HumanoidRootPart
    local thugTarget = thug:FindFirstChild("Head") or thugHRP

    -- Teleport ยืนหน้า Thug
    root.CFrame = thugHRP.CFrame * CFrame.new(0, 0, -3.2) * CFrame.Angles(0, math.rad(180), 0)

    -- หันกล้องเล็งตรงไปที่ Thug
    local camConn = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if camera and root then
            local camPos = root.Position + Vector3.new(0, 1.8, 0) + (root.CFrame.LookVector * -2.5)
            camera.CFrame = CFrame.lookAt(camPos, thugTarget.Position)
        end
    end)

    local dialogue = getDialogue()
    local opened = dialogue and dialogue.Visible == true

    -- กดปุ่ม Talk ทันที
    if not opened then
        for _ = 1, 30 do
            if dialogue and dialogue.Visible then
                opened = true
                break
            end
            local mui = getMuiPrompt()
            local btn = mui and mui:FindFirstChild("Button", true)
            local lbl = btn and btn:FindFirstChild("Label")
            if btn and lbl and lbl.Text == "Talk" then
                for _, c in ipairs(getconnections(btn.Activated)) do
                    c.Function()
                end
                opened = true
                break
            end
            task.wait(0.03)
        end
    end

    -- ขั้นตอนที่ 1: กด "Give me the can." อย่างรวดเร็ว
    local bg = dialogue and dialogue:FindFirstChild("Background")
    for _ = 1, 40 do
        if dialogue and dialogue.Visible and bg then
            local foundOpt = nil
            for _, opt in ipairs(bg:GetChildren()) do
                if opt:IsA("ImageButton") and opt.Name:find("DialogueOption") and opt.Visible then
                    local optLbl = opt:FindFirstChild("DialogueLabel")
                    if optLbl and optLbl.Text:lower():find("give me") then
                        foundOpt = opt
                        break
                    end
                end
            end
            if foundOpt then
                for _, c in ipairs(getconnections(foundOpt.MouseButton1Click)) do
                    c.Function()
                end
                addLog("กดรับสเปรย์ (Give me the can.)")
                break
            end
        end
        task.wait(0.03)
    end

    -- ขั้นตอนที่ 2: กด "Right." ปิดบทสนทนาและเริ่มเควสทันที
    for _ = 1, 40 do
        if not dialogue or not dialogue.Visible then break end
        if bg then
            local foundOpt = nil
            for _, opt in ipairs(bg:GetChildren()) do
                if opt:IsA("ImageButton") and opt.Name:find("DialogueOption") and opt.Visible then
                    local optLbl = opt:FindFirstChild("DialogueLabel")
                    if optLbl and (optLbl.Text:lower():find("right") or optLbl.Text:lower():find("sure") or optLbl.Text:lower():find("okay")) then
                        foundOpt = opt
                        break
                    end
                end
            end
            if foundOpt then
                for _, c in ipairs(getconnections(foundOpt.MouseButton1Click)) do
                    c.Function()
                end
                addLog("ยืนยันเริ่มเควส (Right.)")
                break
            end
        end
        task.wait(0.03)
    end

    camConn:Disconnect()
    task.wait(0.15)
    return true
end

-- พ่นผนัง 1 จุด (รองรับโหมดมุดใต้พื้น ป้องกันการโดนอัดคลิป)
local function sprayWall(wall)
    if not wall then return false end
    unsitPlayer()
    equipSprayCan()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local decal = wall:FindFirstChild("Decal")
    local normal = decal and wall.CFrame:VectorToWorldSpace(Vector3.FromNormalId(decal.Face)) or wall.CFrame.LookVector

    -- คำนวณตำแหน่งพ่น: หากเปิด Stealth จะมุดลงไปใต้ดิน
    local yOffset = stealthSpray and -stealthUnderDepth or 0
    if stealthSpray then
        setNoclip(true)
    end

    local success = false
    -- ลองระยะต่างๆ
    for _, dist in ipairs({2.5, 3.2, 1.8}) do
        local standPos = wall.Position + (normal * dist) + Vector3.new(0, yOffset, 0)
        root.CFrame = CFrame.lookAt(standPos, Vector3.new(wall.Position.X, standPos.Y, wall.Position.Z))

        -- เล็งมุมกล้องขึ้นมาที่ตัวผนัง เพื่อให้ไอคอน [E] ติดแม้ตัวจะอยู่ใต้ดิน
        local camConn = RunService.RenderStepped:Connect(function()
            local camera = workspace.CurrentCamera
            if camera and root then
                local camPos = root.Position + Vector3.new(0, 1.5, 0) + (normal * 2.0)
                camera.CFrame = CFrame.lookAt(camPos, wall.Position)
            end
        end)

        task.wait(0.2)

        for _ = 1, 20 do
            local mui = getMuiPrompt()
            local btn = mui and mui:FindFirstChild("Button", true)
            local lbl = btn and btn:FindFirstChild("Label")
            if mui and mui.Enabled and btn and lbl and lbl.Text == "Spray" then
                for _, c in ipairs(getconnections(btn.Activated)) do
                    c.Function()
                end
                success = true
                break
            end
            task.wait(0.05)
        end

        camConn:Disconnect()
        if success then break end
    end

    if stealthSpray then
        setNoclip(false)
    end

    if success then
        task.wait(0.4)
    end
    return success
end

-- Main Loop (รันต่อเนื่อง ไม่รอคูลดาวน์)
local function mainWorkflow()
    if running then return end
    running = true

    while running do
        local hasCan = equipSprayCan()
        local designated = getDesignatedWalls()

        if not hasCan or #designated == 0 then
            currentStep = "กำลังรับเควสจาก Thug..."
            talkToThugFast()
            task.wait(0.2)
            hasCan = equipSprayCan()
            designated = getDesignatedWalls()
        end

        if not running then break end

        if #designated > 0 then
            addLog(string.format("เริ่มพ่น %d จุด (Stealth: %s)", #designated, stealthSpray and "ใต้พื้น" or "บนพื้น"))
            for idx, wall in ipairs(designated) do
                if not running then break end
                currentStep = string.format("กำลังพ่น [%d/%d] %s", idx, #designated, wall.Name)
                addLog(string.format("-> ไปพ่น %s", wall.Name))

                local sprayed = sprayWall(wall)
                if sprayed then
                    completedCount = completedCount + 1
                    addLog(string.format("✅ พ่นสำเร็จ: %s", wall.Name))
                else
                    addLog(string.format("⚠️ พ่นไม่ติด: %s", wall.Name))
                end
                task.wait(0.15)
            end
        end

        if not loopEnabled then
            addLog("ทำงานครบ 1 รอบ (ปิด Auto-Loop)")
            break
        end

        currentStep = "เตรียมรอบต่อไป..."
        task.wait(0.3)
    end

    running = false
    currentStep = "หยุดทำงานแล้ว"
    addLog("ระบบหยุดการทำงาน")
end

